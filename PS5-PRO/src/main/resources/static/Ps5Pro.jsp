
<html>
<head>
    <meta charset="UTF-8">
    <title>PS5 Details</title>
</head>
<body>

<h2>PS5 Details</h2>

<form action="PS5" method="post">

    <label>ID:</label>
    <input type="number" name="id" required>
    <br><br>

    <label>Model:</label>
    <input type="text" name="model" required>
    <br><br>

    <label>Price:</label>
    <input type="number" step="0.01" name="price" required>
    <br><br>

    <label>Storage:</label>
    <input type="text" name="storage" required>
    <br><br>

    <input type="submit" value="Submit">

</form>

</body>
</html>